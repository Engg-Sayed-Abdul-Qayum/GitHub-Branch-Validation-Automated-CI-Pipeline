// Jenkinsfile — PR validation for the ChatApp (HTML + CSS + Tailwind + JS)
// Runs automatically when a Pull Request is opened/updated (Multibranch Pipeline + GitHub webhook).
// Agent needs: git, Node.js 18+ (npm/npx), python3, curl

pipeline {
    agent any

    options {
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds(abortPrevious: true)   // new push to the PR cancels the older run
    }

    environment {
        PORT = '8089'
    }

    stages {
        stage('Setup') {
            steps {
                sh '''
                    node --version
                    npm --version
                    python3 --version
                    for f in index.html style.css tailwind.config.js script.js; do
                        [ -f "$f" ] && echo "OK: $f" || { echo "MISSING: $f"; exit 1; }
                    done
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '''
                    set -e
                    # JavaScript syntax
                    node --check script.js
                    node --check tailwind.config.js

                    # HTML rules (junit report for Jenkins)
                    npx --yes htmlhint --format junit index.html > report.xml || HTML_FAILED=1
                    npx --yes htmlhint index.html

                    # CSS: balanced braces
                    open=$(tr -cd '{' < style.css | wc -c)
                    close=$(tr -cd '}' < style.css | wc -c)
                    [ "$open" -eq "$close" ]
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    set -e
                    python3 -m http.server ${PORT} > server.log 2>&1 &
                    SERVER_PID=$!
                    trap "kill $SERVER_PID" EXIT
                    sleep 2

                    for path in index.html style.css script.js tailwind.config.js; do
                        code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:${PORT}/$path)
                        echo "GET /$path -> $code"
                        [ "$code" = "200" ]
                    done

                    # Page must be real HTML with a <title> (works even if you rename the app)
                    curl -s http://localhost:${PORT}/index.html -o page.html
                    grep -i "<title>" page.html
                    grep -qi "<title>" page.html
                '''
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'report.xml'
            sh 'pkill -f "http.server ${PORT}" || true'
        }
        success {
            echo 'PR checks passed — safe to merge.'
        }
        failure {
            echo 'PR checks failed — fix the issues and push again.'
        }
    }
}